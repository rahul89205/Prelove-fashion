<section class="section--tight section" {{ section.shopify_attributes }}>
  <div class="container">
    <div class="cta cta--{{ section.settings.colour }}">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
      {%- if section.settings.button_label != blank -%}
        <a class="btn btn--light" href="{{ section.settings.button_link | default: '/pages/sell-with-us' }}">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Call-to-action banner",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Sell with us" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Got good clothes you no longer wear?" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Send us your pre-loved pieces and earn store credit. We handle the photos, listing and packing, and your clothes find a new home." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Start selling" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    {
      "type": "select",
      "id": "colour",
      "label": "Colour",
      "default": "terracotta",
      "options": [
        { "value": "terracotta", "label": "Terracotta" },
        { "value": "sage", "label": "Sage" },
        { "value": "sand", "label": "Sand" }
      ]
    }
  ],
  "presets": [{ "name": "Call-to-action banner" }]
}
{% endschema %}
