<section class="section" {{ section.shopify_attributes }}>
  <div class="container">
    <h2>{{ section.settings.heading }}</h2>
    <div class="accordion" style="max-width:820px">
      {%- for block in section.blocks -%}
        <details {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question }}</summary>
          <div class="accordion__body">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Good questions" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Answer.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "question", "settings": { "question": "How do you grade condition?", "answer": "<p>Like new: worn once or twice, no visible wear. Excellent: lightly worn, minor signs of use only. Good: clearly worn but sound; any flaws are listed on the product page.</p>" } },
        { "type": "question", "settings": { "question": "Can I return an item?", "answer": "<p>Yes. Contact us within 7 days of delivery for unworn items in original condition. Because every piece is one-of-one, we refund to the original payment method once the item is back with us.</p>" } }
      ]
    }
  ]
}
{% endschema %}
