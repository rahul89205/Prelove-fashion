<section class="section" {{ section.shopify_attributes }}>
  <div class="container">
    <div class="section-head">
      <h2>{{ section.settings.heading }}</h2>
      <a class="link-arrow" href="{{ routes.all_products_collection_url }}">Shop everything</a>
    </div>
    <div class="tiles">
      {%- for block in section.blocks -%}
        {%- if block.settings.product_type != blank -%}
          {%- assign tile_url = block.settings.product_type | url_for_type -%}
        {%- else -%}
          {%- assign tile_url = routes.all_products_collection_url -%}
        {%- endif -%}
        <a class="tile tile--{{ block.settings.colour }}" href="{{ tile_url }}" {{ block.shopify_attributes }}>
          <span class="tile__arrow" aria-hidden="true">&nearr;</span>
          <h3>{{ block.settings.label }}</h3>
          {%- if block.settings.blurb != blank -%}<p>{{ block.settings.blurb }}</p>{%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Category tiles",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Outerwear" },
        { "type": "text", "id": "product_type", "label": "Product type to link to", "info": "Must match the Type field on your products, e.g. Outerwear" },
        { "type": "text", "id": "blurb", "label": "Short description" },
        {
          "type": "select",
          "id": "colour",
          "label": "Colour",
          "default": "sage",
          "options": [
            { "value": "sage", "label": "Sage" },
            { "value": "sand", "label": "Sand" },
            { "value": "terracotta", "label": "Terracotta" },
            { "value": "blue", "label": "Dusty blue" },
            { "value": "mustard", "label": "Mustard" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category tiles",
      "blocks": [
        { "type": "tile", "settings": { "label": "Outerwear", "product_type": "Outerwear", "colour": "sage" } },
        { "type": "tile", "settings": { "label": "Knitwear", "product_type": "Knitwear", "colour": "terracotta" } },
        { "type": "tile", "settings": { "label": "Denim", "product_type": "Denim", "colour": "blue" } },
        { "type": "tile", "settings": { "label": "Accessories", "product_type": "Accessories", "colour": "mustard" } }
      ]
    }
  ]
}
{% endschema %}
