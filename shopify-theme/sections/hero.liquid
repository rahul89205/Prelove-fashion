<section class="hero" {{ section.shopify_attributes }}>
  <div class="container hero__grid">
    <div class="hero__text">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h1>{{ section.settings.heading }}</h1>
      <p class="lead">{{ section.settings.subheading }}</p>
      <div class="hero__actions">
        {%- if section.settings.button_label != blank -%}
          <a class="btn" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
        {%- endif -%}
        {%- if section.settings.button2_label != blank -%}
          <a class="btn btn--ghost" href="{{ section.settings.button2_link | default: '/pages/sustainability' }}">{{ section.settings.button2_label }}</a>
        {%- endif -%}
      </div>
    </div>

    <div class="hero__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600, 900, 1200', sizes: '(min-width: 900px) 45vw, 100vw', alt: section.settings.image.alt }}
      {%- else -%}
        <img src="{{ 'hero-flatlay.png' | asset_url }}" alt="A flat lay of pre-loved jackets, knitwear and accessories" width="1600" height="1200" loading="eager">
      {%- endif -%}
      {%- if section.settings.badge != blank -%}
        <span class="hero__badge">{{ section.settings.badge }}</span>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Pre-loved fashion · Auckland" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Good clothes deserve a third life." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Hand-picked, honestly graded second-hand fashion. Every piece is one-of-one, shipped plastic-free, and kept out of landfill." },
    { "type": "text", "id": "button_label", "label": "Primary button label", "default": "Shop new arrivals" },
    { "type": "url", "id": "button_link", "label": "Primary button link" },
    { "type": "text", "id": "button2_label", "label": "Secondary button label", "default": "Our promise" },
    { "type": "url", "id": "button2_link", "label": "Secondary button link" },
    { "type": "text", "id": "badge", "label": "Badge on image", "default": "100% pre-loved" },
    { "type": "image_picker", "id": "image", "label": "Image (leave empty to use the built-in flat lay)" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
