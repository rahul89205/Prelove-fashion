<div class="values" {{ section.shopify_attributes }}>
  <div class="container">
    <ul class="values__list">
      {%- for block in section.blocks -%}
        <li class="values__item" {{ block.shopify_attributes }}>
          {% render 'icon', name: block.settings.icon %}
          <span>{{ block.settings.text }}</span>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Values strip",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "leaf",
          "options": [
            { "value": "leaf", "label": "Leaf" },
            { "value": "recycle", "label": "Recycle" },
            { "value": "tag", "label": "Tag" },
            { "value": "box", "label": "Box" },
            { "value": "heart", "label": "Heart" },
            { "value": "truck", "label": "Truck" }
          ]
        },
        { "type": "text", "id": "text", "label": "Text", "default": "Pre-loved & one-of-one" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Values strip",
      "blocks": [
        { "type": "item", "settings": { "icon": "recycle", "text": "100% pre-loved" } },
        { "type": "item", "settings": { "icon": "box", "text": "Plastic-free packaging" } },
        { "type": "item", "settings": { "icon": "tag", "text": "Honest condition grading" } },
        { "type": "item", "settings": { "icon": "truck", "text": "Free NZ shipping over $100" } }
      ]
    }
  ]
}
{% endschema %}
