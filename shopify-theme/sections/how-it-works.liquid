<section class="section" {{ section.shopify_attributes }}>
  <div class="container">
    <div class="section-head">
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <ol class="steps">
      {%- for block in section.blocks -%}
        <li class="step" {{ block.shopify_attributes }}>
          <span class="step__num">{{ forloop.index }}</span>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "How it works",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "How a piece gets its third life" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Step" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Describe this step." }
      ]
    }
  ],
  "presets": [
    {
      "name": "How it works",
      "blocks": [
        { "type": "step", "settings": { "title": "Sourced", "text": "We collect quality garments from Auckland closets, so they never reach landfill." } },
        { "type": "step", "settings": { "title": "Checked & graded", "text": "Each piece is inspected, cleaned and given an honest condition grade: Like new, Excellent or Good." } },
        { "type": "step", "settings": { "title": "Packed plastic-free", "text": "Orders go out in recycled paper mailers with paper tape. No bubble wrap, no plastic bags." } },
        { "type": "step", "settings": { "title": "Loved again", "text": "Finished with it? Send it back for store credit and it enters the loop again." } }
      ]
    }
  ]
}
{% endschema %}
