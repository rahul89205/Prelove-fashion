<section class="section impact" {{ section.shopify_attributes }}>
  <div class="container">
    <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    <h2>{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}
      <p class="lead">{{ section.settings.text }}</p>
    {%- endif -%}
    <div class="impact__grid">
      {%- for block in section.blocks -%}
        <div class="stat" {{ block.shopify_attributes }}>
          <div class="stat__num">{{ block.settings.number }}</div>
          <p class="stat__label">{{ block.settings.label }}</p>
          {%- if block.settings.source != blank -%}
            <p class="stat__src">{{ block.settings.source }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Impact stats",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why pre-loved" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The most sustainable garment is the one that already exists." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Buying second-hand extends the life of clothing that has already been made, and keeps it out of the landfill." }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "number", "label": "Number", "default": "220,000 t" },
        { "type": "text", "id": "label", "label": "Label", "default": "of textiles are thrown away in New Zealand every year" },
        { "type": "text", "id": "source", "label": "Source", "default": "Estimate: WasteMINZ" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Impact stats",
      "blocks": [
        { "type": "stat", "settings": { "number": "220,000 t", "label": "of textiles are thrown away in New Zealand every year", "source": "Estimate: WasteMINZ" } },
        { "type": "stat", "settings": { "number": "1 of 1", "label": "every piece is a one-off, so nothing is made that does not need to be", "source": "Our model" } },
        { "type": "stat", "settings": { "number": "100%", "label": "of orders ship in recycled or compostable packaging", "source": "Our promise" } }
      ]
    }
  ]
}
{% endschema %}
