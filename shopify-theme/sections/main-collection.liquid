{%- paginate collection.products by section.settings.products_per_page -%}
  <div class="container" {{ section.shopify_attributes }}>

    <header class="collection-head">
      <h1>{{ collection.title }}</h1>
      {%- if collection.description != blank -%}
        <div>{{ collection.description }}</div>
      {%- endif -%}
    </header>

    <form class="toolbar" method="get" id="FilterForm">
      {%- if collection.filters.size > 0 -%}
        <div class="filters">
          {%- for filter in collection.filters -%}
            {%- if filter.type == 'price_range' -%}
              <details class="filter">
                <summary>{{ filter.label }}</summary>
                <div class="filter__panel">
                  <div class="filter__range">
                    <input type="number" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value }}" min="0" placeholder="From" aria-label="Minimum price">
                    <input type="number" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value }}" min="0" placeholder="To" aria-label="Maximum price">
                  </div>
                  <button class="btn" type="submit">Apply</button>
                </div>
              </details>
            {%- else -%}
              <details class="filter" {% if filter.active_values.size > 0 %}open{% endif %}>
                <summary>{{ filter.label }}{% if filter.active_values.size > 0 %} ({{ filter.active_values.size }}){% endif %}</summary>
                <div class="filter__panel">
                  {%- for value in filter.values -%}
                    <label>
                      <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} {% if value.count == 0 and value.active == false %}disabled{% endif %} data-autosubmit>
                      {{ value.label }} ({{ value.count }})
                    </label>
                  {%- endfor -%}
                </div>
              </details>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      <span class="toolbar__count">{{ collection.products_count }} piece{% if collection.products_count != 1 %}s{% endif %}</span>

      <div class="toolbar__controls">
        {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
        <label class="visually-hidden" for="SortBy">Sort by</label>
        <select id="SortBy" name="sort_by" data-autosubmit>
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name }}</option>
          {%- endfor -%}
        </select>
        {%- if collection.filters.size > 0 -%}
          <a class="link-arrow" href="{{ collection.url }}?sort_by={{ sort_by }}">Clear filters</a>
        {%- endif -%}
      </div>
    </form>

    {%- if collection.products.size > 0 -%}
      <ul class="grid">
        {%- for product in collection.products -%}
          <li>{% render 'product-card', product: product %}</li>
        {%- endfor -%}
      </ul>
      {% render 'pagination', paginate: paginate %}
    {%- else -%}
      <div class="empty">
        <h2>Nothing here right now</h2>
        <p>Every piece is one-of-one and the good ones go quickly. Try clearing your filters or check back soon.</p>
        <a class="btn" href="{{ routes.all_products_collection_url }}">See everything</a>
      </div>
    {%- endif -%}
  </div>
  <div style="height:72px"></div>
{%- endpaginate -%}

{% schema %}
{
  "name": "Collection page",
  "settings": [
    { "type": "range", "id": "products_per_page", "label": "Products per page", "min": 8, "max": 24, "step": 4, "default": 12 }
  ]
}
{% endschema %}
