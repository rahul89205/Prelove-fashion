<div class="container center" style="padding:96px 20px;max-width:560px" {{ section.shopify_attributes }}>
  <a class="logo" href="{{ routes.root_url }}" style="margin-bottom:1.5rem"><span class="logo__dot" aria-hidden="true"></span><span>{{ shop.name }}</span></a>
  <h1>Opening soon</h1>
  <p class="lead" style="margin-inline:auto">{{ section.settings.message }}</p>

  {%- form 'storefront_password' -%}
    {{ form.errors | default_errors }}
    <div class="field" style="text-align:left">
      <label for="Password">Enter store password</label>
      <input type="password" name="password" id="Password" autocomplete="current-password">
    </div>
    <button class="btn btn--block" type="submit">Enter</button>
  {%- endform -%}
</div>

{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "textarea", "id": "message", "label": "Message", "default": "Our pre-loved store is getting ready. Check back soon." }
  ]
}
{% endschema %}
